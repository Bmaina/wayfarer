# Required for the LLM agents. Without it the app runs in deterministic "rules mode" and says so in the UI.
ANTHROPIC_API_KEY=
# Optional: override the model id used by every agent.
AGENT_MODEL=claude-sonnet-5-5
# Optional: persist trip requests (Upstash Redis via the Vercel Marketplace). Without it requests are only logged.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required for the LLM agents. Without it the app runs in deterministic "rules mode" and says so in the UI.
ANTHROPIC_API_KEY=
# Only if your key is not scoped to one workspace (the API will say so): your workspace id.
ANTHROPIC_WORKSPACE_ID=
# Only if bearer auth is rejected: set to x-api-key to use the legacy header.
ANTHROPIC_AUTH_MODE=
# Optional: override the model id used by every agent.
AGENT_MODEL=claude-sonnet-5-5
# Optional: persist trip requests (Upstash Redis via the Vercel Marketplace). Without it requests are only logged.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: who the traveller will hear from after a request (shown on the confirmation).
SUPPORT_NAME=
SUPPORT_EMAIL=
SUPPORT_RESPONSE_WINDOW=
